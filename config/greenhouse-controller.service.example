[Unit]
Description=Greenhouse Controller
After=network-online.target mariadb.service
Wants=network-online.target
Requires=mariadb.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/Greenhouse_Controller
ExecStart=/usr/bin/python3 /home/pi/Greenhouse_Controller/scripts/greenhouse_controller.py
Restart=on-failure
RestartSec=10

# Give the controller time to run its safe shutdown path when stopped.
TimeoutStopSec=90
KillSignal=SIGTERM

# Keep Python output visible in journalctl.
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
